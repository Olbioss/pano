    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
