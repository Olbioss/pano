{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pano",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js (and Better Auth, from Phase 1) need Node's APIs in the Worker.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // og.ts reads the app shell through this binding.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /p/* gets the shell with link-preview tags, so it skips the assets layer.
    "run_worker_first": ["/api", "/api/*", "/p/*"]
  },
  "observability": { "enabled": true },
  // Every five minutes: send queued emails, if a status change queued any.
  // Every night at 01:00 UTC: reset the demo workspace. (worker/cron.ts)
  "triggers": { "crons": ["*/5 * * * *", "0 1 * * *"] },
  "kv_namespaces": [
    {
      // Flags the crons read without waking the database.
      "binding": "FLAGS",
      // Placeholder until launch creates the namespace with
      // `wrangler kv namespace create FLAGS`. Local dev keeps its own.
      "id": "00000000000000000000000000000000"
    }
  ],
  "upload_source_maps": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder until Phase 5 creates the real config with
      // `wrangler hyperdrive create`. Local dev never uses the id.
      "id": "00000000000000000000000000000000",
      // Miniflare rejects a connection string without a password. Local
      // Postgres uses trust auth, so this one is ignored.
      "localConnectionString": "postgresql://olbios:local@127.0.0.1:5432/pano"
    }
  ]
}
