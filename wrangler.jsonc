{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pano",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // postgres.js (and Better Auth, from Phase 1) need Node's APIs in the Worker.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // og.ts reads the app shell through this binding.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /p/* gets the shell with link-preview tags, so it skips the assets layer.
    "run_worker_first": ["/api", "/api/*", "/p/*"]
  },
  "observability": {
    "enabled": true
  },
  // Production's settings. Local dev and the tests take theirs from
  // .dev.vars, which wins over these.
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://pano.olbios88.workers.dev"
  },
  // Every five minutes: send queued emails, if a status change queued any.
  // Every night at 01:00 UTC: reset the demo workspace. (worker/cron.ts)
  "triggers": {
    "crons": ["*/5 * * * *", "0 1 * * *"]
  },
  "kv_namespaces": [
    {
      // Flags the crons read without waking the database. Local dev keeps
      // its own namespace; this id is production's.
      "binding": "FLAGS",
      "id": "3cad1a5caaa0409f9a6555661d03446c"
    }
  ],
  "upload_source_maps": true,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6b92702f9ac4436b9c77d2a7e04f7f26",
      // Miniflare rejects a connection string without a password. Local
      // Postgres uses trust auth, so this one is ignored.
      "localConnectionString": "postgresql://olbios:local@127.0.0.1:5432/pano"
    }
  ]
}
